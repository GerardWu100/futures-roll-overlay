outputs/
# Keep portable offline raw inputs tracked in git.
!data/
!data/raw/
!data/raw/futures/
!data/raw/futures/*.parquet
!data/raw/roll_calendars/
!data/raw/roll_calendars/*.parquet
!data/raw/manifest/
